---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  author?: string;
  published?: string;
  sourceUrl?: string;
  tags?: string[];
}

const { title, description, author, published, sourceUrl, tags } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      <div class="meta">
        {author && <span>Tac gia: {author}</span>}
        {published && <span>{new Date(published).toLocaleDateString('vi-VN')}</span>}
        {sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener">Bai goc</a>}
      </div>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .description {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }

  .meta {
    display: flex;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .tags {
    margin-top: 0.75rem;
  }

  .content {
    font-size: 1.05rem;
  }
</style>
