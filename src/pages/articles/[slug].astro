---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const mdxFiles = import.meta.glob('../../content/articles/*.mdx', { eager: true });
  return Object.entries(mdxFiles).map(([path, mod]: [string, any]) => ({
    params: { slug: path.split('/').pop()!.replace('.mdx', '') },
    props: { frontmatter: mod.frontmatter, Content: mod.Content },
  }));
};

const { frontmatter, Content } = Astro.props;
---

<ArticleLayout
  title={frontmatter.title_vi}
  description={frontmatter.description_vi}
  author={frontmatter.author}
  published={frontmatter.published}
  sourceUrl={frontmatter.source_url}
  tags={frontmatter.tags}
>
  <div class="mdx-content">
    <Content />
  </div>
</ArticleLayout>

<style>
  .mdx-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .mdx-content :global(p) {
    margin-bottom: 0.75rem;
  }

  .mdx-content :global(ul),
  .mdx-content :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }

  .mdx-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .mdx-content :global(strong) {
    color: #f1f5f9;
  }

  .mdx-content :global(blockquote) {
    background: #1a2744;
    border: 1px solid #2563eb;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
    color: #93c5fd;
  }

  .mdx-content :global(blockquote a) {
    color: #60a5fa;
    font-weight: 600;
  }

  .mdx-content :global(code) {
    background: #0d1117;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
